# Supabase (required for admin, routes, tourism, reviews, enquiries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Canonical production URL (used by sitemap.xml + robots.txt)
NEXT_PUBLIC_SITE_URL=https://punecabz.com

# Optional: replace hero video with an external URL (defaults to /hero-bg.mp4 in the repo)
# NEXT_PUBLIC_HERO_VIDEO_URL=https://your-project.supabase.co/storage/v1/object/public/media/hero-bg.mp4

# Optional: email new contact-form enquiries + admin OTP login (recommended)
# RESEND_API_KEY=re_xxxx
# RESEND_FROM_EMAIL=Pune Cabz <noreply@yourdomain.com>
# Without Resend, enquiries still save in admin and also try FormSubmit.co → punecabz@gmail.com
# (FormSubmit needs one-time activation: open the confirmation mail and click Activate)
# Admin OTP: without RESEND_API_KEY, codes print in the server console in development.

ADMIN_SESSION_SECRET=generate-a-long-random-secret-here

# Optional env allowlist if admin_users table is not set up yet:
# ADMIN_EMAIL=admin@example.com
# (Password login removed — use email OTP only)
