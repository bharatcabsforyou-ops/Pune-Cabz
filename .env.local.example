# Supabase (required for admin, routes, tourism, reviews, enquiries)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: custom hero video URL (e.g. Supabase Storage public URL). Defaults to CDN if unset.
# NEXT_PUBLIC_HERO_VIDEO_URL=https://your-project.supabase.co/storage/v1/object/public/media/hero-bg.mp4

ADMIN_SESSION_SECRET=generate-a-long-random-secret-here

# Optional env fallback if admin_users table is not set up yet:
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me
